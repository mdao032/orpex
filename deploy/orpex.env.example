# Configuration d'ORPEX en production : copier ce fichier (orpex.env), le remplir, et le protéger
# (lisible seulement par le compte du service : il contient des secrets).

# Base PostgreSQL (17 recommandé)
ORPEX_DB_URL=jdbc:postgresql://localhost:5432/orpex
ORPEX_DB_USER=orpex
ORPEX_DB_PASSWORD=a-remplacer

# Clé de chiffrement du mot de passe SMTP (32 octets en Base64), propre à cette installation.
# Générer : openssl rand -base64 32   (ou, sous Windows, voir deploy/README.md)
# À conserver en lieu sûr : sans elle, le mot de passe SMTP enregistré devra être ressaisi.
ORPEX_SECRET_KEY=a-generer

# Adresse de l'application telle que les utilisateurs l'ouvrent (liens dans les mails).
ORPEX_APP_URL=https://orpex.banque.local

# Premier administrateur : créé au premier démarrage, seulement si aucun compte n'existe ; ignoré ensuite.
# Mot de passe provisoire de 12 caractères au moins, à changer à la première connexion ; retirer ensuite ces lignes.
ORPEX_ADMIN_EMAIL=admin@banque.local
ORPEX_ADMIN_PASSWORD=a-remplacer

# Fuseau de l'installation (pilote : Mali)
ORPEX_TIMEZONE=Africa/Bamako

# HTTPS (obligatoire en production), au choix :
# a) derrière le proxy HTTPS de la banque : le proxy transmet à ORPEX en HTTP sur le réseau interne.
ORPEX_FORWARD_HEADERS=native
ORPEX_COOKIE_SECURE=true
# b) ORPEX sert lui-même le HTTPS (port 8443 par défaut) : décommenter, et retirer les deux lignes du a).
#SPRING_PROFILES_ACTIVE=tls
#ORPEX_TLS_CERTIFICATE=file:/etc/orpex/tls/orpex.crt
#ORPEX_TLS_PRIVATE_KEY=file:/etc/orpex/tls/orpex.key

# Relais SMTP par défaut ; en pratique, il se configure à l'écran « Messagerie » (prioritaire sur ces valeurs).
ORPEX_SMTP_HOST=relais-smtp.banque.local
ORPEX_SMTP_PORT=25
ORPEX_MAIL_FROM=relances@banque.local
ORPEX_SMTP_HELO_NAME=orpex.banque.local

# Port de l'application (8080 en HTTP, 8443 par défaut avec le profil tls)
#ORPEX_PORT=8080

# Tout autre réglage de application.properties se surcharge de la même façon : nom en majuscules, points et tirets
# remplacés par « _ ». Exemples :
#ORPEX_VALIDATION_CUTOFF_MINUTES=30
#ORPEX_WORKER_MAX_LATENESS=PT15M
#SERVER_SERVLET_SESSION_TIMEOUT=30m
