<!--
  Service Windows d'ORPEX avec WinSW 2.12.0 (https://github.com/winsw/winsw/releases/tag/v2.12.0, WinSW-x64.exe).
  Dans C:\ORPEX : orpex.jar, WinSW-x64.exe renommé orpex-service.exe, et ce fichier.
  Installation : voir deploy/README.md. Ce fichier contient des secrets : le réserver aux administrateurs.
-->
<service>
  <id>orpex</id>
  <name>ORPEX</name>
  <description>ORPEX - relances planifiées et expédiées</description>

  <!-- JDK ou JRE 21 ; chemin complet si JAVA_HOME n'est pas défini pour le compte du service. -->
  <executable>%JAVA_HOME%\bin\java.exe</executable>
  <arguments>-XX:MaxRAMPercentage=75 -Dstdout.encoding=UTF-8 -jar "%BASE%\orpex.jar"</arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <env name="ORPEX_DB_URL" value="jdbc:postgresql://localhost:5432/orpex"/>
  <env name="ORPEX_DB_USER" value="orpex"/>
  <env name="ORPEX_DB_PASSWORD" value="a-remplacer"/>
  <env name="ORPEX_SECRET_KEY" value="a-generer"/>
  <env name="ORPEX_APP_URL" value="https://orpex.banque.local"/>
  <env name="ORPEX_ADMIN_EMAIL" value="admin@banque.local"/>
  <env name="ORPEX_ADMIN_PASSWORD" value="a-remplacer"/>
  <env name="ORPEX_TIMEZONE" value="Africa/Bamako"/>
  <env name="ORPEX_LOG_FORMAT" value="ecs"/>
  <!-- HTTPS : derrière le proxy de la banque (ci-dessous), ou servi par ORPEX (voir deploy/README.md). -->
  <env name="ORPEX_FORWARD_HEADERS" value="native"/>
  <env name="ORPEX_COOKIE_SECURE" value="true"/>
  <!--
  <env name="SPRING_PROFILES_ACTIVE" value="tls"/>
  <env name="ORPEX_TLS_CERTIFICATE" value="file:C:/ORPEX/tls/orpex.crt"/>
  <env name="ORPEX_TLS_PRIVATE_KEY" value="file:C:/ORPEX/tls/orpex.key"/>
  -->

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <!-- Arrêt : Ctrl+C envoyé à Java, qui termine un envoi en cours (30 s au plus). -->
  <stoptimeout>40 sec</stoptimeout>

  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
